# Budget Me environment configuration
# Copy to .env, replace every required placeholder, and never commit .env.

# Core runtime -----------------------------------------------------------------
ENVIRONMENT=development

# Supabase Dashboard > Connect > Session pooler (port 5432).
# Percent-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Fernet key used to encrypt Plaid access tokens. Generate with:
#   make generate-key
APP_TOKEN_ENC_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

LOG_LEVEL=INFO

# Plaid ------------------------------------------------------------------------
# Start in Sandbox. Sandbox is free and never connects to real bank accounts.
PLAID_CLIENT_ID=REPLACE_WITH_PLAID_CLIENT_ID
PLAID_SECRET=REPLACE_WITH_PLAID_SANDBOX_SECRET
PLAID_ENV=sandbox

# Required only for OAuth institutions on a deployed HTTPS app.
PLAID_REDIRECT_URI=

# Hosted authentication --------------------------------------------------------
# Local development should leave AUTH_REQUIRED=false.
# Set true on any internet-accessible deployment and allow only trusted emails.
AUTH_REQUIRED=false
AUTH_ALLOWED_EMAILS=

# Used by scripts/generate_secrets.py for Streamlit Google OIDC on Render.
AUTH_REDIRECT_URI=
AUTH_COOKIE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional categorization services --------------------------------------------
# The app works with packaged defaults and PostgreSQL rule overrides when these
# are unset. These services are optional inference/search providers.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional outbound Telegram sync summaries -----------------------------------
# Inbound chat-to-agent automation is intentionally not part of the OSS setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
